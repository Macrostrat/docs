# Tooling dependencies (yarn.lock IS tracked for reproducibility)
.tooling/node_modules/
.tooling/.yarn/

# Assembly output + source caches (produced by .tooling/assemble.mjs)
/.assembled/
/.cache/
/.workspace/

# Local asset mirror — binary media lives in the object store, synced not committed.
# The directory itself (and its README) is tracked; its contents are not.
/docs-assets/*
!/docs-assets/README.md
!/docs-assets/.gitkeep

# Obsidian per-user state (the shared config in .obsidian/app.json IS tracked)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# OS cruft
.DS_Store
